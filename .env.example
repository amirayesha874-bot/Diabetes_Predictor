# Copy this file to ".env" and edit. Nothing here is hard-coded in the source code.
SECRET_KEY=change-me-to-a-long-random-string
# Optional SMTP settings. If SMTP_HOST is empty, emails are saved to the "outbox"
# (visible in Admin > Outbox) instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@diabetes-risk.local
# Default admin account created on first run
ADMIN_EMAIL=admin@diabetes.local
ADMIN_PASSWORD=Admin@12345
